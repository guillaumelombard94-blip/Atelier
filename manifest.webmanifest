{
  "name": "Atelier PDF & images",
  "short_name": "Atelier",
  "description": "Fusionner, compresser, masquer et réécrire des PDF, compresser des images.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EDF0F4",
  "theme_color": "#2F5BEA",
  "lang": "fr",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [".pdf"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/png": [".png"],
        "image/webp": [".webp"]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "launch_handler": { "client_mode": "navigate-new" }
}
